# Copie estas variáveis para o projeto na Vercel (Settings → Environment Variables).
# Nunca commite valores reais neste arquivo.

# Chave pública VAPID — usada no navegador para se inscrever no push. Não é segredo.
VITE_VAPID_PUBLIC_KEY=

# Chave privada VAPID — usada só no servidor para assinar os pushes. Mantenha em segredo.
VAPID_PRIVATE_KEY=

# Contato do dono da aplicação, exigido pelo protocolo Web Push.
VAPID_SUBJECT=mailto:seuemail@exemplo.com

# Token secreto que só o cron externo conhece, usado para chamar /api/send-due.
CRON_SECRET=

# Preenchida automaticamente pela Vercel quando você conecta o banco Postgres (Neon) ao projeto.
DATABASE_URL=
